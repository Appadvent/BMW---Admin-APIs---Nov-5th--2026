{
  "name": "streamline",
  "version": "1.0.0",
  "main": "app.ts",
  "scripts": {
    "start": "node dist/app.ts",
    "swagger": "npx ts-node src/swagger.ts",
    "index": "nodemon app.ts",
    "build": "npx prisma db push --skip-generate && npx prisma generate && tsc",
    "dev": "ts-node-dev --respawn --pretty --transpile-only ./src/app.ts",
    "prisma:generate": "npx prisma generate",
    "prisma:push": "npx prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "npx prisma migrate deploy",
    "db:clear": "npx ts-node src/scripts/clearData.ts",
    "db:seed": "npx ts-node src/scripts/seedDummyData.ts",
    "db:seed-subcategories": "npx ts-node src/scripts/seedSubcategories.ts",
    "db:reset": "npm run db:clear && npm run seed",
    "seed": "npx ts-node src/scripts/clearData.ts && npx ts-node src/scripts/seedDummyData.ts && npx ts-node src/scripts/seedSubcategories.ts && npx ts-node src/scripts/seedBanners.ts && npx ts-node src/scripts/seedBlogs.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.928.0",
    "@aws-sdk/lib-storage": "^3.928.0",
    "@prisma/client": "^6.0.1",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "joi": "^17.13.3",
    "joi-to-swagger": "^6.2.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.12.6",
    "localstack": "^1.0.0",
    "minio": "^8.0.7",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "node-input-validator": "^4.5.1",
    "nodemailer": "^6.10.1",
    "prisma": "^6.0.1",
    "sanitize-html": "^2.16.0",
    "swagger-autogen": "^2.23.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/date-fns": "^2.5.3",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/mime-types": "^2.1.4",
    "@types/minio": "^7.1.0",
    "@types/mock-aws-s3": "^2.6.3",
    "@types/multer": "^1.4.13",
    "@types/multer-s3": "^3.0.3",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^6.4.17",
    "@types/sanitize-html": "^2.15.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "eslint": "^9.16.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}